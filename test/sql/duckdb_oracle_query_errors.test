# name: test/sql/duckdb_oracle_query_errors.test
# description: oracle_query argument validation and error reporting (no server needed)
# group: [duckdb_oracle]
#
# The harness (zig build sqllogictest) exports ORACLE_USER=u and
# ORACLE_PASSWORD=slt-secret-pw-7f3a, so these statements reach the connect step
# without any inline credentials.

require duckdb_oracle

statement error
SELECT * FROM oracle_query(NULL, 'select 1 from dual');
----
dsn must not be NULL

statement error
SELECT * FROM oracle_query('127.0.0.1:1/NOPE', NULL);
----
sql must not be NULL

statement error
SELECT * FROM oracle_query('127.0.0.1:1/NOPE', 'select 1 from dual', user := '');
----
no user given

# Passwords are never accepted as SQL arguments: DuckDB echoes the failing SQL
# text (including literals) in error messages and the CLI keeps a history.
statement error
SELECT * FROM oracle_query('127.0.0.1:1/NOPE', 'select 1 from dual', password := 'p');
----
Invalid named parameter "password"

# The password comes from an environment variable; password_env names it.
statement error
SELECT * FROM oracle_query('127.0.0.1:1/NOPE', 'select 1 from dual', password_env := 'DUCKDB_ORACLE_TEST_SURELY_UNSET');
----
DUCKDB_ORACLE_TEST_SURELY_UNSET

statement error
SELECT * FROM oracle_query('127.0.0.1:1/NOPE', 'select 1 from dual', password_env := NULL);
----
password_env must not be NULL

# Timeouts are seconds in [0, 4294967]; 0 means no limit
statement error
SELECT * FROM oracle_query('127.0.0.1:1/NOPE', 'select 1 from dual', timeout := -1);
----
timeout must be between 0 and

statement error
SELECT * FROM oracle_query('127.0.0.1:1/NOPE', 'select 1 from dual', connect_timeout := NULL);
----
connect_timeout must not be NULL

statement error
SELECT * FROM oracle_query('127.0.0.1:1/NOPE', 'select 1 from dual', connect_timeout := 5000000000);
----
connect_timeout must be between 0 and

# SQL that cannot be run is refused before any connection is made
statement error
SELECT * FROM oracle_query('127.0.0.1:1/NOPE', '  ;  ');
----
sql must not be empty

statement error
SELECT * FROM oracle_query('127.0.0.1:1/NOPE', 'select * from dual for update');
----
FOR UPDATE

statement error
SELECT * FROM oracle_query('127.0.0.1:1/NOPE', 'select * from dual for
   update nowait;');
----
FOR UPDATE

# ... but FOR UPDATE inside a literal is just text, so this one gets as far as connecting
statement error
SELECT * FROM oracle_query('127.0.0.1:1/NOPE', 'select ''for update'' from dual;');
----
<REGEX>:.*duckdb_oracle: .*(DPI-1047|ORA-125[0-9][0-9]).*

# Authentication mode: password (default) or external (wallet, Kerberos, OS)
statement error
SELECT * FROM oracle_query('127.0.0.1:1/NOPE', 'select 1 from dual', auth := 'kerberos');
----
auth must be 'password' or 'external'

statement error
SELECT * FROM oracle_query('127.0.0.1:1/NOPE', 'select 1 from dual', auth := NULL);
----
auth must not be NULL

statement error
SELECT * FROM oracle_query('127.0.0.1:1/NOPE', 'select 1 from dual', auth := 'external', user := 'scott');
----
auth := 'external' takes no user

# external authentication needs no ORACLE_USER / ORACLE_PASSWORD: it reaches the connect step
statement error
SELECT * FROM oracle_query('127.0.0.1:1/NOPE', 'select 1 from dual', auth := 'external');
----
<REGEX>:.*duckdb_oracle: .*(DPI-1047|ORA-125[0-9][0-9]).*

# How NUMBERs without an exact DECIMAL form are materialised
statement error
SELECT * FROM oracle_query('127.0.0.1:1/NOPE', 'select 1 from dual', unconstrained_number := 'decimal');
----
unconstrained_number must be 'double', 'lossy_double' or 'varchar'

statement error
SELECT * FROM oracle_query('127.0.0.1:1/NOPE', 'select 1 from dual', unconstrained_number := NULL);
----
unconstrained_number must not be NULL

# valid values reach the connect step (and fail there, as no server exists)
statement error
SELECT * FROM oracle_query('127.0.0.1:1/NOPE', 'select 1 from dual', unconstrained_number := 'VARCHAR');
----
<REGEX>:.*duckdb_oracle: .*(DPI-1047|ORA-125[0-9][0-9]).*

# Unknown named parameters are rejected by DuckDB's binder
statement error
SELECT * FROM oracle_query('127.0.0.1:1/NOPE', 'select 1 from dual', schema := 'x');
----
<REGEX>:.*(Invalid named parameter|schema).*

# Unreachable DSN: without Instant Client this is DPI-1047 (client missing),
# with Instant Client it is an ORA-125xx connect error. Either way a clean
# DuckDB error containing the code, never a crash.
statement error
SELECT * FROM oracle_query('127.0.0.1:1/NOPE', 'select 1 from dual');
----
<REGEX>:.*duckdb_oracle: .*(DPI-1047|ORA-125[0-9][0-9]).*

# A failing connect must never echo the secret that was read from the environment.
statement error
SELECT * FROM oracle_query('127.0.0.1:1/NOPE', 'select 1 from dual');
----
<!REGEX>:.*slt-secret-pw-7f3a.*

# the process (and the extension) are still healthy afterwards
query I
SELECT count(*) FROM oracle_client_info();
----
1
